{
  "version": 2,
  "builds": [
    {
      "src": "api/contact.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/api/contact",
      "dest": "api/contact.py"
    },
    {
      "src": "/about",
      "dest": "/about.html"
    },
    {
      "src": "/skills",
      "dest": "/skills.html"
    },
    {
      "src": "/projects",
      "dest": "/projects.html"
    },
    {
      "src": "/contact",
      "dest": "/contact.html"
    }
  ]
}